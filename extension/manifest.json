{
  "manifest_version": 3,
  "name": "Stream Timestamp Saver",
  "version": "0.1",
  "description": "Automatically saves and restores your position in YouTube and Rumble videos",
  "action": {
    "default_icon": {
      "16": "favicon/favicon-16x16.png",
      "32": "favicon/favicon-32x32.png"
    },
    "default_title": "Stream Timestamp Saver",
    "default_popup": "build/index.html"
  },
  "icons": {
    "16": "favicon/favicon-16x16.png", 
    "32": "favicon/favicon-32x32.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/watch*", 
        "*://rumble.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "styles/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage", 
    "tabs", 
    "scripting"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://rumble.com/*"
  ]
}