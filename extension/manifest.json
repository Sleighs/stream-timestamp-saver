{
  "manifest_version": 3,
  "name": "Stream Timestamp Saver",
  "version": "0.1",
  "description": "Automatically saves and restores your position in YouTube and Rumble videos",
  "action": {
    "default_icon": {
      "16": "favicon/favicon-16x16.png",
      "32": "favicon/favicon-32x32.png"
    },
    "default_title": "Stream Timestamp Saver",
    "default_popup": "build/index.html"
  },
  "icons": {
    "16": "favicon/favicon-16x16.png", 
    "32": "favicon/favicon-32x32.png"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.rumble.com/*"
      ],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage", 
    "tabs", 
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.rumble.com/*"
  ]
}